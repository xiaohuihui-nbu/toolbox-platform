# Copy manually or let scripts/start.ps1 generate unique credentials.
BIND_ADDRESS=127.0.0.1
FA_SECRET_KEY=replace-with-random-signing-key
WEB_PORT=18990
DB_PASSWORD=GENERATE_RANDOM_VALUE
DB_ROOT_PASSWORD=GENERATE_RANDOM_VALUE
TB_DATABASE_URL=mysql+pymysql://toolbox:GENERATE_RANDOM_VALUE@mysql:3306/toolbox?charset=utf8mb4
TB_REDIS_URL=redis://redis:6379/0
TB_S3_ENDPOINT=http://minio:9000
TB_S3_ACCESS_KEY=toolbox
TB_S3_SECRET_KEY=GENERATE_RANDOM_VALUE
TB_ADMIN_PASSWORD=GENERATE_RANDOM_VALUE
TB_S3_BUCKET=toolbox
TB_DOWNLOAD_PROXY=http://egress:8899
# Optional HTTP multi-connection downloader; benefit depends on the source.
TB_DOWNLOAD_ENGINE=native
TB_DOWNLOAD_CONNECTIONS=4
# Optional trusted DNS-over-HTTPS resolver for hosts using a fake-IP TUN proxy.
TB_EGRESS_DOH=
# Optional local resolver for Bilibili CDN domains under TUN fake-IP DNS.
TB_EGRESS_DOMESTIC_DOH=https://dns.alidns.com/resolve
TB_EGRESS_DOMESTIC_DOMAINS=bilibili.com,bilivideo.com,bilivideo.cn,biliimg.com,hdslb.com,b23.tv
TB_COOKIE_SECURE=false
TB_GPTSOVITS_ORIGIN=http://host.docker.internal:9880
TB_MAX_ACTIVE_JOBS=25
TB_MAX_UPLOAD_MB=100
TB_USER_STORAGE_MB=2048
