{
  "name": "toolbox-platform-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:workspace && npm run build:admin",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node tests/toolbox/browser-check.mjs",
    "test:media": "node tests/toolbox/media-check.mjs",
    "format": "prettier --write src/views/toolbox src/components/toolbox src/tool-views src/api/toolbox src/composables/toolbox src/styles/toolbox.css tests/toolbox",
    "test:search": "node tests/toolbox/search-check.mjs",
    "test:tasks": "node tests/toolbox/tasks-check.mjs",
    "test:batch-delete": "node tests/toolbox/batch-delete-check.mjs",
    "test:studio": "node tests/toolbox/studio-check.mjs",
    "build:workspace": "vue-tsc --noEmit -p tsconfig.toolbox.json && vite build",
    "build:admin": "vite build --config vite.admin.config.ts --mode admin"
  },
  "dependencies": {
    "element-plus": "2.14.3",
    "lucide-vue-next": "0.577.0",
    "pinia": "3.0.4",
    "vue": "3.5.34",
    "vue-router": "5.0.7",
    "@element-plus/icons-vue": "2.3.2",
    "@iconify-json/ep": "^1.2.3",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify/vue": "5.0.0",
    "@tailwindcss/vite": "4.2.4",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.1",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "13.9.0",
    "@wangeditor-next/editor": "^5.7.0",
    "@wangeditor-next/editor-for-vue": "^5.1.14",
    "axios": "1.15.2",
    "codemirror": "^5.65.21",
    "codemirror-editor-vue3": "^2.8.0",
    "cron-parser": "^5.6.2",
    "crypto-js": "4.2.0",
    "dagre": "^0.8.5",
    "dayjs": "1.11.20",
    "dompurify": "^3.4.3",
    "echarts": "6.0.0",
    "exceljs": "^4.4.0",
    "file-saver": "2.0.5",
    "highlight.js": "11.11.1",
    "markdown-it": "^14.1.0",
    "mitt": "3.0.1",
    "nprogress": "0.2.0",
    "ohash": "2.0.11",
    "pinia-plugin-persistedstate": "4.7.1",
    "qrcode.vue": "3.9.0",
    "qs": "^6.15.0",
    "tailwindcss": "4.2.4",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "9.14.4",
    "vue-img-cutter": "3.0.7",
    "vue-json-pretty": "^2.5.0",
    "vue-web-terminal": "^3.4.1",
    "vue3-cron-plus": "^0.1.9",
    "xgplayer": "3.0.24",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "6.0.4",
    "prettier": "^3.9.9",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vue-tsc": "3.2.5",
    "autoprefixer": "^10.4.21",
    "sass": "1.99.0",
    "terser": "5.46.2",
    "unplugin-auto-import": "20.3.0",
    "unplugin-element-plus": "0.10.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "29.2.0",
    "@types/node": "24.12.2",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.14.0",
    "@types/file-saver": "^2.0.7",
    "@types/markdown-it": "^14.1.2"
  }
}
