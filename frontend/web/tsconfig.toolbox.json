{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/main.ts",
    "src/views/toolbox/**/*.vue",
    "src/components/toolbox/**/*.vue",
    "src/tool-views/**/*.vue",
    "src/api/toolbox/**/*.ts",
    "src/composables/toolbox/**/*.ts",
    "vite.config.ts"
  ]
}
