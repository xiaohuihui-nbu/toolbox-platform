FROM node:22.23.2-bookworm-slim AS javascript
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 ENVIRONMENT=dev PYTHONPATH=/srv/backend
WORKDIR /srv/backend
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg espeak-ng curl && rm -rf /var/lib/apt/lists/*
COPY backend/requirements-toolbox.lock /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
RUN apt-get update && apt-get install -y --no-install-recommends aria2 && rm -rf /var/lib/apt/lists/*
COPY --from=javascript /usr/local/bin/node /usr/local/bin/node
COPY backend /srv/backend
COPY services /srv/services
RUN useradd --uid 10001 --create-home toolbox && mkdir -p /srv/backend/logs /srv/backend/static && chown -R toolbox:toolbox /srv/backend/logs /srv/backend/static
USER toolbox
CMD ["uvicorn", "app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
