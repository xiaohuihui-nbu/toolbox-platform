{
  "plugin_id": "tts",
  "version": "1.0.0",
  "sdk_version": 1,
  "tools": [
    {
      "id": "tts.natural",
      "name": "AI 自然配音",
      "category": "音频工具",
      "icon": "AudioLines",
      "color": "coral",
      "description": "GPT-SoVITS 中文自然音色，合成后直接试听。",
      "tags": [
        "16 种音色",
        "CPU"
      ],
      "mode": "job",
      "note": "使用本机 GPT-SoVITS v2ProPlus，CPU 合成需要等待；参考音为合成预置样例，最终语气可能不同。最多 1000 字，建议先试一句短文。",
      "version": "1.0.0",
      "handler": "plugins.tts.natural:execute",
      "resource_profile": "provider_io",
      "timeout_seconds": 840,
      "max_output_bytes": 104857600,
      "schema_ref": "app.toolbox.schemas.tools:NaturalSpeechInput"
    },
    {
      "id": "tts.basic",
      "name": "文字转语音",
      "category": "音频工具",
      "icon": "AudioLines",
      "color": "coral",
      "description": "把文字变成声音，离线 CPU 即可运行。",
      "tags": [
        "离线",
        "TTS"
      ],
      "mode": "job",
      "note": "内置 eSpeak NG 基础音色，适合流程验证；自然中文音色请使用 AI 自然配音。",
      "version": "1.0.0",
      "handler": "plugins.tts.basic:execute",
      "resource_profile": "media_cpu",
      "timeout_seconds": 840,
      "max_output_bytes": 104857600,
      "schema_ref": "app.toolbox.schemas.tools:SpeechInput"
    }
  ]
}
